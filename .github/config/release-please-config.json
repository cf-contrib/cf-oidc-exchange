{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "cloudflare-sts",
      "include-v-in-tag": true,
      "include-v-in-release-name": true,
      "include-component-in-tag": false,
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "extra-files": [
        "README.md",
        "action/README.md",
        "deployment/terraform/README.md",
        "deployment/terraform/variables.tf",
        "crates/cloudflare-sts-cli/Cargo.toml",
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='cloudflare-sts-cli')].version"
        }
      ]
    }
  }
}
